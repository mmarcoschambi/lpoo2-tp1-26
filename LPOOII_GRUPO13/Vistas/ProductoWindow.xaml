<Window x:Class="Vistas.ProductoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alta de Productos" Height="455" Width="650"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Alta de Productos" FontSize="20" FontWeight="Bold" Margin="5"/>
        <WrapPanel Grid.Row="1" Margin="0,8">
            <Button x:Name="btnNuevo" Content="Nuevo" Width="75" Height="30" Margin="3" Click="btnNuevo_Click" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnModificar" Content="Modificar" Width="75" Height="30" Margin="3" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnEliminar" Content="Eliminar" Width="75" Height="30" Margin="3" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnGuardar" Content="Guardar" Width="75" Height="30" Margin="3" Click="btnGuardar_Click" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnCancelar" Content="Cancelar" Width="75" Height="30" Margin="3" Click="btnCancelar_Click" Style="{StaticResource EstiloBotonProducto}"/>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="30,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/><RowDefinition Height="40"/></Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Código:"/><TextBox Grid.Row="0" Grid.Column="1" x:Name="txtCodProducto" Height="25" MaxLength="20"/>
            <Label Grid.Row="1" Content="Categoría:"/><TextBox Grid.Row="1" Grid.Column="1" x:Name="txtCategoria" Height="25" MaxLength="50"/>
            <Label Grid.Row="2" Content="Color:"/><TextBox Grid.Row="2" Grid.Column="1" x:Name="txtColor" Height="25" MaxLength="30"/>
            <Label Grid.Row="3" Content="Descripción:"/><TextBox Grid.Row="3" Grid.Column="1" x:Name="txtDescripcion" Height="25" MaxLength="100"/>
            <Label Grid.Row="4" Content="Precio:"/><TextBox Grid.Row="4" Grid.Column="1" x:Name="txtPrecio" Height="25" MaxLength="12"/>
        </Grid>
        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="btnPrimero" Content="Primero" Width="75" Margin="3" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnAnterior" Content="Anterior" Width="75" Margin="3" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnSiguiente" Content="Siguiente" Width="75" Margin="3" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnUltimo" Content="Último" Width="75" Margin="3" Style="{StaticResource EstiloBotonProducto}"/>
            <Button x:Name="btnSalir" Content="Salir" Width="75" Margin="90,3,3,3" Click="btnSalir_Click" Style="{StaticResource EstiloBotonProducto}"/>
        </StackPanel>
    </Grid>
</Window>
